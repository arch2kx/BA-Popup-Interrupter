{
  "manifest_version": 3,
  "name": "BA Pop-Up Interrupter",
  "description": "Annoys you with pop-ups of Blue Archive characters periodically.",
  "version": "1.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "ba-popup-interrupter@arch2kx.pages.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "images/icons/icon-16.png",
    "32": "images/icons/icon-32.png",
    "48": "images/icons/icon-48.png",
    "128": "images/icons/icon-128.png"
  },

  "action": {
    "default_icon": {
      "16": "images/icons/icon-16.png",
      "32": "images/icons/icon-32.png",
      "48": "images/icons/icon-48.png",
      "128": "images/icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },

  "options_page": "options.html",

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage", "offscreen", "alarms", "tabs", "scripting"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["images/actual-popup/*.png", "sounds/*.mp3", "offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
